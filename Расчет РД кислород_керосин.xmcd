		<region region-id="187" left="18" top="2054.25" width="381" height="15" align-x="33" align-y="2064" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Каждая молекула О<f family="Arial" charset="0" size="10">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">
							<sub>2</sub>
						</inlineAttr>
					</f>
					<f family="Arial" charset="0" size="10">
						<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false"> содержит 2 атома, следовательно нужно 37/2 = 18.5 молей </inlineAttr>
					</f>О<sub>2</sub>
				</p>
			</text>
		</region>
		<region region-id="189" left="18" top="2078.25" width="127.5" height="12" align-x="27.75" align-y="2088" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
